  <node xmi:id="_z8v4wvyLEfC11OYjg9hGww" componentName="cProcessor" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="192" posY="256">
    <elementParameter xmi:id="_z8v4w_yLEfC11OYjg9hGww" field="TEXT" name="UNIQUE_NAME" value="cProcessor_1" show="false"/>
    <elementParameter xmi:id="_z8v4xPyLEfC11OYjg9hGww" field="MEMO_JAVA" name="CODE" value="/*&#xA;* Provide own codes to consume or translate the message exchanges.&#xA;* @param org.apache.camel.Exchange exchange&#xA;*/&#xA;exchange.getIn().setHeader(&quot;WAMASpartnerID&quot;, context.parameter_WAMASpartnerID);&#xA;exchange.getIn().setHeader(&quot;WAMASID&quot;, context.parameter_WAMASID);&#xA;exchange.getIn().setHeader(&quot;WAMASclientID&quot;, context.parameter_WAMASclientID);&#xA;exchange.getIn().setHeader(&quot;WAMASwhLoc&quot;, context.parameter_WAMASwhLoc);&#xA;exchange.getIn().setHeader(&quot;WAMASvariant&quot;, context.parameter_WAMASvariant);&#xA;exchange.getIn().setHeader(&quot;WAMAS_Empty_item&quot;, context.parameter_WAMAS_Empty_item);&#xA;&#xA;/*String IbdUUID = &quot;IBD&quot; + UUID.randomUUID().toString().replace(&quot;-&quot;,&quot;&quot;);*/&#xA;Date currentDate = new Date();&#xA;int ibdSeq = Numeric.sequence(&quot;IBD&quot;, 1, 1);&#xA;if (ibdSeq > 9999) {&#xA;&#x9;Numeric.resetSequence(&quot;IBD&quot;, 0);&#xA;&#x9;ibdSeq = Numeric.sequence(&quot;IBD&quot;, 1, 1);&#xA;}&#xA;String DateUUID = new SimpleDateFormat(&quot;yyyyMMddHHmm&quot;).format(currentDate.getTime()) + String.format(&quot;%04d&quot;,ibdSeq);&#xA;exchange.getIn().setHeader(&quot;DateUUID&quot;, DateUUID);&#xA;String IbdNo = &quot;IBDTMK&quot; + DateUUID;&#xA;exchange.getIn().setHeader(&quot;IbdNo&quot;, IbdNo);&#xA;String IbdDate = new SimpleDateFormat(&quot;yyyyMMddHHmmss&quot;).format(new Date());&#xA;exchange.getIn().setHeader(&quot;IbdDate&quot;, IbdDate);&#xA;"/>
    <elementParameter xmi:id="_z8v4xfyLEfC11OYjg9hGww" field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;&#xA;import java.util.UUID;&#xA;import java.util.Date;&#xA;import java.text.SimpleDateFormat;&#xA;import java.util.concurrent.TimeUnit;"/>
    <elementParameter xmi:id="_z8v4xvyLEfC11OYjg9hGww" field="TEXT" name="LABEL" value="set context and uid to header"/>
    <elementParameter xmi:id="_z8v4x_yLEfC11OYjg9hGww" field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <elementParameter xmi:id="_z8v4yPyLEfC11OYjg9hGww" field="LABEL" name="ROUTE_BREAKPOINT_EXAMPLE" value="Example: Lauguages=Simple, Expression=&quot;${body} contains 'Camel'&quot;"/>
  </node>
