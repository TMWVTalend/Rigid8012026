    <elementParameter xmi:id="_z21fnfyLEfC11OYjg9hGww" field="TEXT" name="UNIQUE_NAME" value="cProcessor_3" show="false"/>
    <elementParameter xmi:id="_z21fnvyLEfC11OYjg9hGww" field="MEMO_JAVA" name="CODE" value="/*&#xA;* Provide own codes to consume or translate the message exchanges.&#xA;* @param org.apache.camel.Exchange exchange&#xA;*/&#xA;String ArinvtId = exchange.getIn().getHeader(&quot;ArinvtId&quot;, String.class);&#xA;&#xA;&#xA;java.util.Map&lt;String, String> queryMap = new java.util.LinkedHashMap&lt;String, String>();                    &#xA;&#xA;queryMap.put(&quot;ArInvtID&quot;, ArinvtId);                   &#xA;queryMap.put(&quot;currentShiftOnly&quot;, &quot;false&quot;);                   &#xA;queryMap.put(&quot;filter&quot;, &quot;workcenterid.eq~&quot; + exchange.getIn().getHeader(&quot;StationId&quot;, String.class) + &quot;~&quot;);&#xA;exchange.getIn().setHeader(org.apache.camel.component.cxf.common.message.CxfConstants.CAMEL_CXF_RS_QUERY_MAP, queryMap);&#xA;/* calculate julian day for batch */&#xA;SimpleDateFormat formatter = new SimpleDateFormat(&quot;yyyy-MM-dd'T'HH:mm:ss.SSSXXX&quot;);&#xA;String JProdDate = exchange.getIn().getHeader(&quot;DateProd&quot;, String.class);&#xA;Date JDate = formatter.parse(JProdDate);&#xA;//String JulianDate = new SimpleDateFormat(&quot;D&quot;).format(JDate);&#xA;//String JulianPad = (&quot;000&quot; + JulianDate).substring(JulianDate.length());&#xA;String bot_date = &quot;01/01/2000&quot;;&#xA;SimpleDateFormat sdf = new SimpleDateFormat(&quot;dd/MM/yyyy&quot;);&#xA;Date begin_of_time = sdf.parse(bot_date);&#xA;long diffInMilli = JDate.getTime() - begin_of_time.getTime();&#xA;long diff = TimeUnit.DAYS.convert(diffInMilli, TimeUnit.MILLISECONDS);&#xA;int diffint = (int)(diff % 26) + 65;&#xA;//System.out.println((char)diffint);&#xA;exchange.getIn().setHeader(&quot;julianDay&quot;, (char)diffint);&#xA;&#xA;System.out.println(&quot;auth token: &quot; + context.authtoken);&#xA;exchange.getIn().setHeader(&quot;AuthToken&quot;, context.authtoken);&#xA;exchange.getIn().setHeader(&quot;Content-Type&quot;, &quot;application/json&quot;);"/>
    <elementParameter xmi:id="_z21fn_yLEfC11OYjg9hGww" field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;&#xA;import java.util.Date;&#xA;import java.text.SimpleDateFormat;&#xA;import java.util.concurrent.TimeUnit;"/>
    <elementParameter xmi:id="_z21foPyLEfC11OYjg9hGww" field="TEXT" name="LABEL" value="set query parameters"/>
    <elementParameter xmi:id="_z21fofyLEfC11OYjg9hGww" field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <elementParameter xmi:id="_z21fovyLEfC11OYjg9hGww" field="LABEL" name="ROUTE_BREAKPOINT_EXAMPLE" value="Example: Lauguages=Simple, Expression=&quot;${body} contains 'Camel'&quot;"/>
  </node>
