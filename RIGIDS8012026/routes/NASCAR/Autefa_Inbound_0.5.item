  <note xmi:id="_zyi4APyLEfC11OYjg9hGww" opaque="true" posX="96" posY="-352" sizeHeight="161" sizeWidth="705" text="This route uses a job to get all the unprocessed SQL IMS_OPC_transaction&#xD;&#xA;records.&#xD;&#xA;It checks if inbound and output auto processing is enabled. &#xD;&#xA;It then routes the transaction based on item and line id.&#xD;&#xA;6/2020 - add Export logic D09-D12 treat loader out as tipper out / Add tray flag = 2 logic&#xD;&#xA;3/2022 - add check of tray flags on 0 qty return of empty from loader out - if any tray flag set - do not process &#xD;&#xA;3/2020-2 - add check of null in qty from loader out"/>
  <note xmi:id="_zyi4AfyLEfC11OYjg9hGww" opaque="true" posX="1152" posY="416" sizeHeight="65" sizeWidth="385" text="&lt;- Floor dispo moved to processing of 204 message">
    <elementParameter xmi:id="_zyi4AvyLEfC11OYjg9hGww" field="COLOR" name="NOTE_COLOR" value="255;0;0"/>
  </note>
  <note xmi:id="_zyi4A_yLEfC11OYjg9hGww" opaque="false" posX="704" posY="1312" sizeHeight="65" sizeWidth="257" text="&lt;--- Need to split out inventory transfer &#xD;&#xA;and drive off of 204 message">
