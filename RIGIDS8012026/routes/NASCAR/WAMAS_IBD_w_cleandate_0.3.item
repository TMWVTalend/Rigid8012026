  <node xmi:id="_z_GB7fyLEfC11OYjg9hGww" componentName="cProcessor" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="160" posY="224">
    <elementParameter xmi:id="_z_GB7vyLEfC11OYjg9hGww" field="TEXT" name="UNIQUE_NAME" value="cProcessor_1" show="false"/>
    <elementParameter xmi:id="_z_GB7_yLEfC11OYjg9hGww" field="MEMO_JAVA" name="CODE" value="/*&#xA;* Provide own codes to consume or translate the message exchanges.&#xA;* @param org.apache.camel.Exchange exchange&#xA;*/&#xA;exchange.getIn().setHeader(&quot;WAMASpartnerID&quot;, context.parameter_WAMASpartnerID);&#xA;exchange.getIn().setHeader(&quot;WAMASID&quot;, context.parameter_WAMASID);&#xA;exchange.getIn().setHeader(&quot;WAMASclientID&quot;, context.parameter_WAMASclientID);&#xA;exchange.getIn().setHeader(&quot;WAMASwhLoc&quot;, context.parameter_WAMASwhLoc);&#xA;exchange.getIn().setHeader(&quot;WAMASvariant&quot;, context.parameter_WAMASvariant);&#xA;exchange.getIn().setHeader(&quot;WAMAS_Empty_item&quot;, context.parameter_WAMAS_Empty_item);&#xA;&#xA;/*String IbdUUID = &quot;IBD&quot; + UUID.randomUUID().toString().replace(&quot;-&quot;,&quot;&quot;);*/&#xA;Date currentDate = new Date();&#xA;int ibdSeq = Numeric.sequence(&quot;IBD&quot;, 1, 1);&#xA;if (ibdSeq > 9999) {&#xA;&#x9;Numeric.resetSequence(&quot;IBD&quot;, 0);&#xA;&#x9;ibdSeq = Numeric.sequence(&quot;IBD&quot;, 1, 1);&#xA;}&#xA;String DateUUID = new SimpleDateFormat(&quot;yyyyMMddHHmm&quot;).format(currentDate.getTime()) + String.format(&quot;%04d&quot;,ibdSeq);&#xA;exchange.getIn().setHeader(&quot;DateUUID&quot;, DateUUID);&#xA;String IbdNo = &quot;IBDTMK&quot; + DateUUID;&#xA;exchange.getIn().setHeader(&quot;IbdNo&quot;, IbdNo);&#xA;String IbdDate = new SimpleDateFormat(&quot;yyyyMMddHHmmss&quot;).format(new Date());&#xA;exchange.getIn().setHeader(&quot;IbdDate&quot;, IbdDate);&#xA;/* calculate curing date */&#xA;Date curingDate = new Date(currentDate.getTime() + TimeUnit.DAYS.toMillis( 1 ));&#xA;String curingDateString = new SimpleDateFormat(&quot;yyyyMMddHHmmss&quot;).format(curingDate);&#xA;exchange.getIn().setHeader(&quot;curingDate&quot;, curingDateString);&#xA;/* calculate exp date */&#xA;Date expDate = new Date(currentDate.getTime() + TimeUnit.DAYS.toMillis( 180 ));&#xA;String expDateString = new SimpleDateFormat(&quot;yyyyMMddHHmmss&quot;).format(expDate);&#xA;exchange.getIn().setHeader(&quot;expDate&quot;, expDateString);&#xA;/* calculate julian day for batch */&#xA;SimpleDateFormat formatter = new SimpleDateFormat(&quot;yyyy-MM-dd'T'HH:mm:ss.SSSXXX&quot;);&#xA;String JProdDate = exchange.getIn().getHeader(&quot;DateProd&quot;, String.class);&#xA;Date JDate = formatter.parse(JProdDate);&#xA;//String JulianDate = new SimpleDateFormat(&quot;D&quot;).format(JDate);&#xA;//String JulianPad = (&quot;000&quot; + JulianDate).substring(JulianDate.length());&#xA;//&#xA;// calculate lot suffix as from A-Z using modulo 26 calc&#xA;// Set beginning of time date&#xA;String bot_date = &quot;01/01/2000&quot;;&#xA;SimpleDateFormat sdf = new SimpleDateFormat(&quot;dd/MM/yyyy&quot;);&#xA;Date begin_of_time = sdf.parse(bot_date);&#xA;long diffInMilli = JDate.getTime() - begin_of_time.getTime();&#xA;long diff = TimeUnit.DAYS.convert(diffInMilli, TimeUnit.MILLISECONDS);&#xA;int diffint = (int)(diff % 26) + 65;&#xA;//System.out.println((char)diffint);&#xA;exchange.getIn().setHeader(&quot;julianDay&quot;, (char)diffint);&#xA;//&#xA;// Calculate Cure Date in format as required by WAMAS&#xA;//&#xA;String SCureDays = exchange.getIn().getHeader(&quot;CureDays&quot;, String.class);&#xA;int iCureDays = Integer.parseInt(SCureDays);&#xA;Date dCureDate = new Date(currentDate.getTime() + TimeUnit.DAYS.toMillis( iCureDays ));&#xA;String CureDateString = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(dCureDate);&#xA;exchange.getIn().setHeader(&quot;wamasCureDate&quot;, CureDateString);&#xA;//&#xA;// Calculate Expiration Date in format as required by WAMAS&#xA;//&#xA;String SShelfLife = exchange.getIn().getHeader(&quot;ShelfLife&quot;, String.class);&#xA;int iShelfLife = Integer.parseInt(SShelfLife);&#xA;Date dExpDate = new Date(currentDate.getTime() + TimeUnit.DAYS.toMillis( iShelfLife ));&#xA;String ExpDateString = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(dExpDate);&#xA;exchange.getIn().setHeader(&quot;wamasExpDate&quot;, ExpDateString);&#xA;"/>
    <elementParameter xmi:id="_z_GB8PyLEfC11OYjg9hGww" field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;&#xA;import java.util.UUID;&#xA;import java.util.Date;&#xA;import java.text.SimpleDateFormat;&#xA;import java.util.concurrent.TimeUnit;"/>
    <elementParameter xmi:id="_z_GB8fyLEfC11OYjg9hGww" field="TEXT" name="LABEL" value="set context and uid to header"/>
    <elementParameter xmi:id="_z_GB8vyLEfC11OYjg9hGww" field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <elementParameter xmi:id="_z_GB8_yLEfC11OYjg9hGww" field="LABEL" name="ROUTE_BREAKPOINT_EXAMPLE" value="Example: Lauguages=Simple, Expression=&quot;${body} contains 'Camel'&quot;"/>
  </node>
