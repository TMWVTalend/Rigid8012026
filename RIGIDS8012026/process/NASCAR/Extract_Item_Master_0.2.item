    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select a.id,&#xD;&#xA;   a.id,&#xD;&#xA;   a.class,&#xD;&#xA;a.itemno,&#xD;&#xA;a.descrip,&#xD;&#xA;a.descrip2,&#xD;&#xA;&#x9;a.loose_weight, &#xD;&#xA;&#x9;b.uom, b.conv_value, c.cust_itemno  &#xD;&#xA;    from arinvt a&#xD;&#xA;join arinvt_uom_conv b on b.arinvt_id = a.id &#xD;&#xA;join aka c on c.arinvt_id = a.id &#xD;&#xA;where a.eplant_id = '&quot; + context.parameter_WebAPI_eplant_id + &quot;' &#xD;&#xA;and a.itemno &lt; '5.' &#xD;&#xA;and not (a.itemno like '%EXP%'  or a.itemno like '%IMP%')&#xD;&#xA;and (pk_hide = 'N' or pk_hide IS NULL)&#xD;&#xA;order by a.id, b.uom&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
    <elementParameter field="CHECK" name="SPECIFY_DATASOURCE_ALIAS" value="false"/>
