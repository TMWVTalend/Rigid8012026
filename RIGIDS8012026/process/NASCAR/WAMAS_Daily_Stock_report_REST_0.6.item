    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select fgmulti.arinvt_id arinvt_id, &#xD;&#xA; fgmulti.lotno lotno, &#xD;&#xA; sum(fgmulti.onhand) onhand,&#xD;&#xA; min(aka.cust_itemno) gcas,&#xD;&#xA; min(aka.info_so) schedAgreement&#xD;&#xA; from FGMULTI fgmulti, locations locations&#xD;&#xA; outer apply&#xD;&#xA;   (select a1.cust_itemno, a1.info_so&#xD;&#xA;       from aka a1 where a1.arinvt_id = fgmulti.arinvt_id and fgmulti.eplant_id = &quot; + context.parameter_WebAPI_eplant_id + &quot;&#xD;&#xA;       and rownum = 1 and a1.arcusto_id = 3076) aka&#xD;&#xA;        where fgmulti.eplant_id = &quot; + context.parameter_WebAPI_eplant_id + &quot;&#xD;&#xA;         and locations.id = fgmulti.loc_id&#xD;&#xA;         and locations.descrip = 'WAMAS Stack ID'&#xD;&#xA;         and locations.loc_desc &lt;> 'PROD'&#xD;&#xA;         and fgmulti.lotno IS NOT NULL&#xD;&#xA;         group by fgmulti.arinvt_Id, fgmulti.lotno&#xD;&#xA;         order by fgmulti.arinvt_id, fgmulti.lotno&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
