    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;with trncnt as&#xD;&#xA;(select count(a1.id) trncount, a1.id from arinvt a1&#xD;&#xA;&#x9; inner join translog t1 on a1.id = t1.arinvt_id&#xD;&#xA;&#x9;       and t1.trans_type &lt;> 'NEW ITEM'&#xD;&#xA;&#x9;       and a1.eplant_id = 21&#xD;&#xA;&#x9;        group by a1.id&#xD;&#xA;&#x9;        having count(a1.id) >= 1&#xD;&#xA;&#x9; order by a1.id&#xD;&#xA; )&#xD;&#xA;select aka.arinvt_id arinvt_id,&#xD;&#xA; 'None' as lotno,&#xD;&#xA; '0' as onhand,&#xD;&#xA; aka.cust_itemno gcas,&#xD;&#xA; aka.info_so schedAgreement&#xD;&#xA; from AKA aka&#xD;&#xA;inner join arinvt arinvt on aka.arinvt_id = arinvt.id and arinvt.eplant_id = &quot; + context.parameter_WebAPI_eplant_id + &quot;&#xD;&#xA;and AKA.arcusto_id = 3076 and (arinvt.pk_hide = 'N' or arinvt.pk_hide IS NULL)&#xD;&#xA;inner join trncnt on aka.arinvt_id = trncnt.id&#xD;&#xA;&quot;"/>
