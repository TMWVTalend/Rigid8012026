  <node componentName="tOracleInput" componentVersion="0.102" offsetLabelX="-3" offsetLabelY="14" posX="896" posY="96">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tOracleInput_1" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tOracleConnection_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="CONNECTION_TYPE" value="ORACLE_SERVICE_NAME"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="ORACLE_12"/>
    <elementParameter field="TEXT" name="RAC_URL" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="HOST" value="context.IQMSJDBCHost"/>
    <elementParameter field="TEXT" name="TYPE" value="ORACLE_SERVICE_NAME" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="context.IQMSJDBCPort"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;iqms&quot;"/>
    <elementParameter field="TEXT" name="LOCAL_SERVICE_NAME" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;IQMS&quot;"/>
    <elementParameter field="TEXT" name="USER" value="context.IQMSJDBCUser"/>
    <elementParameter field="PASSWORD" name="PASS" value="context.IQMSJDBCPass"/>
    <elementParameter field="TEXT" name="JDBC_URL" value="&quot;jdbc:oracle:oci:/@talend&quot;" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;with&#xD;&#xA;am1c1 as (select a1.itemno, a1.id, a1.descrip, o1.ptsper, o1.sndop_id from arinvt a1, opmat o1&#xD;&#xA;&#x9;&#x9;   where a1.cuser10 = 'T1' and a1.eplant_id = '&quot; + context.WebAPI_eplant_id + &quot;' and a1.id = &#xA; o1.arinvt_id &#xD;&#xA;&#x9;&#x9;),&#xD;&#xA;am1c2 as (select a1.itemno, a1.id, a1.descrip, o1.ptsper, o1.sndop_id from arinvt a1, opmat o1&#xD;&#xA;&#x9;&#x9;   where a1.cuser10 = 'T2' and a1.eplant_id = '&quot; + context.WebAPI_eplant_id + &quot;' and a1.id = &#xA; o1.arinvt_id &#xD;&#xA;&#x9;&#x9;),    &#xD;&#xA;am2c1 as (select a1.itemno, a1.id, a1.descrip, o1.ptsper, o1.sndop_id from arinvt a1, opmat o1&#xD;&#xA;&#x9;&#x9;   where a1.cuser10 = 'T1' and a1.eplant_id = '&quot; + context.WebAPI_eplant_id + &quot;' and a1.id = o1.arinvt_id &#xD;&#xA;&#x9;&#x9;),&#xD;&#xA;am2c2 as (select a1.itemno, a1.id, a1.descrip, o1.ptsper, o1.sndop_id from arinvt a1, opmat o1&#xD;&#xA;&#x9;&#x9;   where a1.cuser10 = 'T2' and a1.eplant_id = '&quot; + context.WebAPI_eplant_id + &quot;' and a1.id = o1.arinvt_id &#xD;&#xA;&#x9;&#x9;)    &#xD;&#xA;select&#xD;&#xA;&#x9;wc.id wcid,&#xD;&#xA;&#x9;rtrim(wc.eqno) as eqno,&#xD;&#xA;&#x9;sched1.cntr_seq cntrseq1,&#xD;&#xA;&#x9;sched1.workorder_id workorderid1,&#xD;&#xA;    ar1.itemno itemno1,&#xD;&#xA;    ar1.id itemarinvtid1,&#xD;&#xA;    std1.mfgno mfgno1,&#xD;&#xA;    ar1.descrip desc1,&#xD;&#xA;    ar1.shelf_life shelflife,&#xD;&#xA;    ar1.wait_time curedays,&#xD;&#xA;    ar1.loose_weight itemweightdesign,&#xD;&#xA;    std1.nuser2 itemweightavg,&#xD;&#xA;&#x9;sched2.cntr_seq cntrseq2,&#xD;&#xA;&#x9;sched2.workorder_id workorderid2,&#xD;&#xA;&#x9;ar2.itemno itemno2,&#xD;&#xA;    ar2.id itemarinvtid2,&#xD;&#xA;    std2.mfgno mfgno2,&#xD;&#xA;    ar2.descrip desc2,&#xD;&#xA;&#x9;std1.id id1,&#xD;&#xA;    am1c1.itemno w1comp1,&#xD;&#xA;    am1c1.descrip w1comp1desc,&#xD;&#xA;    am1c1.id w1comp1arinvtid,&#xD;&#xA;    am1c1.ptsper w1comp1ptsper,&#xD;&#xA;    ( am1c1.ptsper * wo1.cycles_req) w1comp1ptsreq,&#xD;&#xA;    am1c2.itemno w1comp2,&#xD;&#xA;    am1c2.descrip w1comp2desc,&#xD;&#xA;    am1c2.id w1comp2arinvtid,&#xD;&#xA;    am1c2.ptsper w1comp2ptsper,&#xD;&#xA;    ( am1c2.ptsper * wo1.cycles_req) w1comp2ptsreq,&#xD;&#xA;&#x9;std2.id id2,&#xD;&#xA;    am2c1.itemno w2comp1,&#xD;&#xA;    am2c1.descrip w2comp1desc,&#xD;&#xA;    am2c1.id w2comp1arinvtid,&#xD;&#xA;    am2c2.itemno w2comp2,&#xD;&#xA;    am2c2.descrip w2comp2desc,&#xD;&#xA;    am2c2.id w2comp2arinvtid,&#xD;&#xA;    uom1.conv_value stackqty&#xD;&#xA;from&#xD;&#xA;    work_center wc&#xD;&#xA;    left outer join cntr_sched sched1 on sched1.work_center_id = wc.id and sched1.cntr_seq = 1&#xD;&#xA;    left outer join cntr_sched sched2 on sched2.work_center_id = wc.id and sched2.cntr_seq = 2&#xD;&#xA;    /* workorder 1 components */&#xD;&#xA;    left outer join workorder wo1 on wo1.id = sched1.workorder_id&#xD;&#xA;    left outer join standard std1 on std1.id = wo1.standard_id&#xD;&#xA;    left outer join partno pn1 on pn1.standard_id = std1.id&#xD;&#xA;    left outer join arinvt ar1 on ar1.id = pn1.arinvt_id&#xD;&#xA;    left outer join ptoper pt1 on pt1.partno_id = pn1.id and pt1.opseq = 1&#xD;&#xA;    left outer join sndop sn1 on sn1.id = pt1.sndop_id&#xD;&#xA;    left outer join arinvt_uom_conv uom1 on uom1.arinvt_id = ar1.id and uom1.uom = 'STK' &#xD;&#xA;    /* workorder 2 components */&#xD;&#xA;    left outer join workorder wo2 on wo2.id = sched2.workorder_id&#xD;&#xA;    left outer join standard std2 on std2.id = wo2.standard_id&#xD;&#xA;    left outer join partno pn2 on pn2.standard_id = std2.id&#xD;&#xA;    left outer join arinvt ar2 on ar2.id = pn2.arinvt_id&#xD;&#xA;    left outer join ptoper pt2 on pt2.partno_id = pn2.id and pt2.opseq = 1&#xD;&#xA;    left outer join sndop sn2 on sn2.id = pt2.sndop_id&#xD;&#xA;    /* workorder 1 components */&#xD;&#xA;    left outer join am1c1 on am1c1.sndop_id = sn1.id&#xD;&#xA;    left outer join am1c2 on am1c2.sndop_id = sn1.id&#xD;&#xA;    /* workorder 2 components */&#xD;&#xA;    left outer join am2c1 on am2c1.sndop_id = sn2.id&#xD;&#xA;    left outer join am2c2 on am2c2.sndop_id = sn2.id&#xD;&#xA;where &#xD;&#xA;&#x9;wc.eplant_id = '&quot; + context.WebAPI_eplant_id + &quot;' and (wc.pk_hide is null or wc.pk_hide &lt;> 'Y')&#xD;&#xA;order by wc.eqno&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
