    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select&#xD;&#xA;  swo.IQMSWorkCenterID,&#xD;&#xA;  swo.DateTimeProdStart,&#xD;&#xA;  swo.WorkOrder,&#xD;&#xA;  swo.id,&#xD;&#xA;  swo.proditemnowamas,&#xD;&#xA;  swo.tipperItemNoWamas1,&#xD;&#xA;  swo.tipperQtyReq1,&#xD;&#xA;  swo.tipperQtyDel1,&#xD;&#xA;  swo.tipperItemNoWamas2,&#xD;&#xA;  swo.tipperQtyReq2,&#xD;&#xA;  swo.tipperQtyDel2,&#xD;&#xA;  swo.proditemnoiqms,&#xD;&#xA;  sid.LineID LOLINEID,&#xD;&#xA;  swt.ItemWeightGrams ITEMWEIGHT,&#xD;&#xA;  swt.QAHold&#xD;&#xA;from (select IQMSWorkCenterID, max(id) maxid&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;from IMS_Station_WO swosub group by IQMSWorkCenterID) lastWo&#xD;&#xA;inner join IMS_Station_WO swo on swo.id = lastwo.maxid&#xD;&#xA;inner join IMS_Station_ID sid on sid.IQMSWorkCenterID = swo.IQMSWorkCenterID and sid.Linetype = 'LO'&#xD;&#xA;inner join IMS_Station_Weight swt on swt.LineID = sid.LineID&#xD;&#xA;where swo.IQMSWorkCenterID = '&quot; + globalMap.get(&quot;iqms_eqno&quot;) + &quot;'&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
