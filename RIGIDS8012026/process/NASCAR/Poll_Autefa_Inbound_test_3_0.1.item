    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select&#xD;&#xA;  opc.id,&#xD;&#xA;  opc.batch,&#xD;&#xA;  opc.lineid,&#xD;&#xA;  opc.quantity,&#xD;&#xA;  opc.stackid,&#xD;&#xA;  opc.TrayFlag1,&#xD;&#xA;  opc.TrayFlag2,&#xD;&#xA;  opc.TrayFlag3,&#xD;&#xA;  opc.TrayFlag4,&#xD;&#xA;  opc.TrayFlag5,&#xD;&#xA;  opc.TrayFlag6,&#xD;&#xA;  opc.itemnumber,&#xD;&#xA;  rtrim(sid.linetype) linetype,&#xD;&#xA;  sid.IQMSWorkCenterID,&#xD;&#xA;  swo.DateTimeProdStart,&#xD;&#xA;  swo.WorkOrder,&#xD;&#xA;  swo.id,&#xD;&#xA;  swo.proditemnowamas,&#xD;&#xA;  swo.tipperItemNoWamas1,&#xD;&#xA;  swo.tipperQtyReq1,&#xD;&#xA;  swo.tipperQtyDel1,&#xD;&#xA;  swo.tipperItemNoWamas2,&#xD;&#xA;  swo.tipperQtyReq2,&#xD;&#xA;  swo.tipperQtyDel2,&#xD;&#xA;  swo.proditemcuredays,&#xD;&#xA;  swo.proditemshelflife,&#xD;&#xA;  swo.proditemnoiqms,&#xD;&#xA;  wlu.batch lubatch,&#xD;&#xA;  wlu.datecuring ludatecuring,&#xD;&#xA;  wlu.dateexpiry ludateexpiry,&#xD;&#xA;  wlu.itemnumber luitem&#xD;&#xA;from IMS_OPC_transaction opc&#xD;&#xA;join IMS_Station_ID sid on sid.LineID = opc.LineID&#xD;&#xA;left outer join (select IQMSWorkCenterID, max(id) maxid&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;from IMS_Station_WO swosub group by IQMSWorkCenterID) lastWo on lastWo.IQMSWorkCenterID = &#xA; sid.IQMSWorkCenterID&#xD;&#xA;left outer join IMS_Station_WO swo on swo.id = lastwo.maxid&#xD;&#xA;left outer join IMS_WAMAS_LU wlu on wlu.stackid = opc.stackid&#xD;&#xA;where&#xD;&#xA;   opc.DateTimeProcessed is null&#xD;&#xA;order by&#xD;&#xA;   opc.id&quot;"/>
