  <note opaque="true" posX="736" posY="-288" sizeHeight="161" sizeWidth="513" text="This job provides multiple rest services from the SQL database&#xD;&#xA;&#xD;&#xA;** IMPORTANT - Don't add loadonce maps to additional URIs&#xD;&#xA;** This cause them to reload each time any URI is called&#xD;&#xA;&#xD;&#xA;5/1/2020 - modify workCenterJobs to preload master weight &#xD;&#xA;&#x9;- to avoid multiple queries over WAN&#xD;&#xA;6/2020 - add workCenterJobsExport URI for export screens"/>
  <note opaque="true" posX="1408" posY="32" sizeHeight="64" sizeWidth="289" text="&lt;-- All job for all work centers"/>
  <note opaque="true" posX="1408" posY="192" sizeHeight="64" sizeWidth="321" text="&lt;-- Only jobs for export work centers D09 - D12&#xD;&#xA;       With item that ends in 'EXP'"/>
  <subjob>
