    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select &#xD;&#xA;loc.loc_desc stack_id,&#xD;&#xA;loc.id loc_id,&#xD;&#xA;fgm.arinvt_id,&#xD;&#xA;avt.itemno,&#xD;&#xA;fgm.onhand,&#xD;&#xA;fgm.id fgmulti_Id,&#xD;&#xA;case when substr(loc.loc_desc, 1, 2) = 'QA' then 'yes' else 'no' end inqa,&#xD;&#xA;fgm.lotno,&#xD;&#xA;avt.standard_id&#xD;&#xA;from locations loc&#xD;&#xA;join fgmulti fgm on fgm.loc_id = loc.id&#xD;&#xA;join arinvt avt on avt.id = fgm.arinvt_id&#xD;&#xA;where loc.eplant_id = '&quot; + context.parameter_WebAPI_eplant_id + &quot;'&#xD;&#xA;and (loc.loc_desc like '&quot; + globalMap.get(&quot;stack_id&quot;) + &quot;%'&#xD;&#xA;or loc.loc_desc like 'QA&quot; + globalMap.get(&quot;stack_id&quot;) + &quot;%' )&#xD;&#xA;and fgm.onhand > 0&#xD;&#xA;and fgm.arinvt_id = &quot; + globalMap.get(&quot;arinvt_id&quot;)"/>
