  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="960" posY="288">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="TECHNICAL" name="SCHEMA:SCHEMA_TYPE" value="REPOSITORY" show="false"/>
    <elementParameter field="TECHNICAL" name="SCHEMA:REPOSITORY_SCHEMA_TYPE" value="_JovuEMrcEeegkf46nwJaMQ - IMS_Audit_Trail" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xA;output_row.ID = input_row.ID;&#xD;&#xA;output_row.ItemNumber = input_row.ItemNumber;&#xD;&#xA;output_row.StackId = input_row.StackId;&#xA;output_row.DateTimeTransaction = input_row.ProdDate;&#xA;System.out.println(&quot;\nMessageSource: &quot; + input_row.MessageSource);&#xA;System.out.println(&quot;\nInspMode: &quot; + input_row.InspMode);&#xA;System.out.println(&quot;\nInspItem: &quot; + input_row.InspItem);&#xA;if (((input_row.MessageSource != null) &amp;&amp; (input_row.MessageSource.equals(&quot;VENDORIMPORT&quot;))) || ((input_row.InspMode != null) &amp;&amp; (input_row.InspMode.equals(&quot;INSPECT&quot;)))) {&#xD;&#xA;&#x9;output_row.Batch = input_row.Batch;&#xA;&#x9;if ((input_row.InspMode != null) &amp;&amp; (input_row.InspMode.equals(&quot;INSPECT&quot;))){&#xA;&#x9;&#x9;output_row.ItemNumber = input_row.InspItem;&#xA;&#x9;&#x9;output_row.DateTimeTransaction = TalendDate.getCurrentDate();&#xA;&#x9;}&#xA;}&#xA;else&#xA;{&#xA;&#x9;Date JDate = input_row.ProdDate;&#xA;&#x9;String bot_date = &quot;01/01/2000&quot;;&#xA;&#x9;SimpleDateFormat sdf = new SimpleDateFormat(&quot;dd/MM/yyyy&quot;);&#xA;&#x9;Date begin_of_time = sdf.parse(bot_date);&#xA;&#x9;long diffInMilli = JDate.getTime() - begin_of_time.getTime();&#xA;&#x9;long diff = TimeUnit.DAYS.convert(diffInMilli, TimeUnit.MILLISECONDS);&#xA;&#x9;int diffint = (int)(diff % 26) + 65;&#xA;&#x9;//output_row.Batch = &quot;TMTS&quot; + input_row.Batch + (char)diffint;&#xA;&#x9;output_row.Batch = &quot;TMTS&quot; + input_row.Batch;&#xA;}&#xD;&#xA;output_row.Quantity = input_row.Quantity;&#xD;&#xA;output_row.TransType = &quot;IBD&quot;;&#xD;&#xA;output_row.XMLFileName = input_row.XMLFileName;&#xD;&#xA;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;&#xA;import java.util.Date;&#xA;import java.text.SimpleDateFormat;&#xA;import java.util.concurrent.TimeUnit;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
