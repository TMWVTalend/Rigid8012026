  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="920" posY="240">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xD;&#xA;output_row.LineID = input_row.LineID;&#xD;&#xA;output_row.IQMSWorkCenterID = input_row.IQMSWorkCenterID;&#xD;&#xA;output_row.LineType = input_row.LineType;&#xD;&#xA;output_row.LineDesc = input_row.LineDesc;&#xD;&#xA;output_row.WAMASTransactionType = input_row.WAMASTransactionType;&#xD;&#xA;output_row.WAMASTransactionID = input_row.WAMASTransactionID;&#xD;&#xA;output_row.CurrentStatus = input_row.CurrentStatus;&#xD;&#xA;output_row.DateTimeReceived = input_row.DateTimeReceived;&#xD;&#xA;output_row.DateTimeUpdated = input_row.DateTimeUpdated;&#xD;&#xA;//output_row.ItemNo = input_row.JSONData;&#xD;&#xA;JSONObject obj = new JSONObject(input_row.JSONData);&#xA;//JSONObject Stack = obj.getJSONObject(&quot;StackComplete&quot;);&#xA;//System.out.println(&quot;Json Parsing:&quot;);&#xA;//System.out.println(Stack.get(&quot;ItemNumber&quot;).toString());&#xA;String valueINeed=&quot;&quot;;&#xA;int count = 0;&#xA;for (Object key : obj.keySet()) {&#xA;            //based on you key types&#xA;            String keyStr = (String)key;&#xA;            Object keyvalue = obj.get(keyStr);&#xA;&#xA;            valueINeed = keyStr;&#xA;            count++;&#xA;&#xA;            /*check here for the appropriate value and do whatever you want*/&#xA;            //Print key and value&#xA;            //System.out.println(&quot;key: &quot;+ keyStr + &quot; value: &quot; + keyvalue);&#xA;&#xA;            if(count==1)&#xA;                break;&#xA;&#xA;        }&#xA;&#xA;//System.out.println(valueINeed);&#xA;&#xA;output_row.ItemNo = &quot;&quot;;&#xA;output_row.StackId = &quot;&quot;;&#xA;&#xA;&#xA;// pull item from IBDRequest JSON - Stack complete&#xA;// need to check if item number missing on insp return so we can pull item from luitem field instead (mssql database)&#xA;if (valueINeed.equals(&quot;StackComplete&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;StackComplete&quot;);&#xA;output_row.StackId = Stack.get(&quot;StackId&quot;).toString();&#xA;try{&#xA;&#x9;output_row.ItemNo = Stack.get(&quot;ItemNumber&quot;).toString();&#xA;&#x9;}&#xA;catch (Exception e) {&#xA;&#x9;output_row.ItemNo = Stack.get(&quot;luitem&quot;).toString();&#xA;&#x9;}&#x9;&#xA;}&#xA;&#xA;// special logic for errors when testing insp return at startup //&#xA;if (valueINeed.equals(&quot;StackCompletex&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;StackCompletex&quot;);&#xA;output_row.StackId = Stack.get(&quot;StackId&quot;).toString();&#xA;try{&#xA;&#x9;output_row.ItemNo = Stack.get(&quot;ItemNumber&quot;).toString();&#xA;&#x9;}&#xA;catch (Exception e) {&#xA;&#x9;output_row.ItemNo = Stack.get(&quot;luitem&quot;).toString();&#xA;&#x9;}&#x9;&#xA;}&#xA;&#xA;// pull item from OBDRequest JSON&#xA;if (valueINeed.equals(&quot;OBDRequest&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;OBDRequest&quot;);&#xA;output_row.ItemNo = Stack.get(&quot;ItemNumber&quot;).toString();&#xA;}&#xA;&#xA;// pull stackid from transfer &#xA;if (valueINeed.equals(&quot;LUTransfer&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;LUTransfer&quot;);&#xA;output_row.StackId = Stack.get(&quot;StackId&quot;).toString();&#xA;}&#xA;&#xA;// pull ibd id from ibd cancel&#xA;if (valueINeed.equals(&quot;IBDCancel&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;IBDCancel&quot;);&#xA;output_row.StackId = Stack.get(&quot;TransID&quot;).toString();&#xA;}&#xA;&#xA;// pull obd id from obd cancel&#xA;if (valueINeed.equals(&quot;OBDCancel&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;OBDCancel&quot;);&#xA;output_row.StackId = Stack.get(&quot;TransID&quot;).toString();&#xA;}&#xA;&#xA;// pull obd id from obd cancel&#xA;if (valueINeed.equals(&quot;LUTransferCancel&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;LUTransferCancel&quot;);&#xA;output_row.StackId = Stack.get(&quot;TransID&quot;).toString();&#xA;}&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;&#xA;import org.json.JSONArray;&#xA;import org.json.JSONException;&#xA;import org.json.JSONObject;"/>
    <elementParameter field="TEXT" name="LABEL" value="extract info from JSON"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
