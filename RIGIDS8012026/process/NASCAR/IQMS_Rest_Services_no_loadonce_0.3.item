    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select&#xD;&#xA;&#x9;isi.IQMSWorkCenterID,&#xD;&#xA;&#x9;isi.Linetype,&#xD;&#xA;&#x9;isi.LineID,&#xD;&#xA;&#x9;opc.opc_history_ndx ID,&#xD;&#xA;&#x9;opc.StackIDPadded StackID,&#xD;&#xA;&#x9;opc.QuantityTotal_Units Quantity,&#xD;&#xA;&#x9;opc.TrayFlag1, opc.TrayFlag2, opc.TrayFlag3, &#xD;&#xA;&#x9;opc.TrayFlag4, opc.TrayFlag5, opc.TrayFlag6,&#xD;&#xA;&#x9;opc.t_stamp DateTimeReceived, opc.LoggingTrigger_Outbound&#xD;&#xA;from &#xD;&#xA;&#x9;dbo.IMS_Station_ID isi&#xD;&#xA;&#x9;cross apply (select top 1 &#xD;&#xA;&#x9;&#x9;opc.opc_history_ndx, opc.StackIDPadded, opc.QuantityTotal_Units, &#xD;&#xA;&#x9;&#x9;opc.TrayFlag1, opc.TrayFlag2, opc.TrayFlag3, &#xD;&#xA;&#x9;&#x9;opc.TrayFlag4, opc.TrayFlag5, opc.TrayFlag6,&#xD;&#xA;&#x9;&#x9;opc.t_stamp, opc.LoggingTrigger_Outbound&#xD;&#xA;&#x9;from dbo.OPC_History opc&#xD;&#xA;&#x9;where opc.LineID_Outbound = isi.LineID&#xD;&#xA;&#x9;order by opc.t_stamp desc&#xD;&#xA;) opc&#xD;&#xA;where isi.IQMSWorkCenterID = '&quot; + &#xD;&#xA; globalMap.get(&quot;lastOPCData.workCenter&quot;) +&#xD;&#xA;&quot;' and isi.Linetype = 'LO'&#xD;&#xA;order by isi.IQMSWorkCenterID&quot;"/>
