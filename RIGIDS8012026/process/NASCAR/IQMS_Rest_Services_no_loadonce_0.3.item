    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT &#xD;&#xA;&#x9;IMS_Station_ID.ID,&#x9;&#xD;&#xA;&#x9;IMS_Station_ID.LineID,&#xA;&#x9;IMS_Station_ID.IQMSWorkCenterID,&#xA;&#x9;IMS_Station_ID.Linetype,&#xA;&#x9;IMS_Station_ID.LineDesc&#xA;FROM&#x9;IMS_Station_ID&#xD;&#xA;WHERE IMS_Station_ID.IQMSWorkCenterID = '&quot; + &#xA; globalMap.get(&quot;workCenterLoaderTippers.WorkCenter&quot;) +&#xD;&#xA;&quot;'&quot; + &#xD;&#xA;&quot; OR '&quot; + globalMap.get(&quot;workCenterLoaderTippers.WorkCenter&quot;) + &quot;' = 'null'&quot; +&#xD;&#xA;&quot; OR ('&quot; + globalMap.get(&quot;workCenterLoaderTippers.WorkCenter&quot;) + &quot;' = 'IN' and &#xD;&#xA;(IMS_Station_ID.Linetype = 'LI' or IMS_Station_ID.Linetype = 'T1I' or IMS_Station_ID.Linetype = 'T2I' or IMS_Station_ID.Linetype = 'ISI'))&quot; +&#xD;&#xA;&quot; OR ('&quot; + globalMap.get(&quot;workCenterLoaderTippers.WorkCenter&quot;) + &quot;' = 'OUT' and &#xD;&#xA;(IMS_Station_ID.Linetype = 'LO' or IMS_Station_ID.Linetype = 'T1O' or IMS_Station_ID.Linetype = 'T2O' or IMS_Station_ID.Linetype = 'ISO'))&#xD;&#xA;order by IMS_Station_ID.IQMSWorkCenterID, IMS_Station_ID.Linetype&quot;"/>
