    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select&#xD;&#xA;  opc.id,&#xD;&#xA;  opc.batch,&#xD;&#xA;  opc.lineid,&#xD;&#xA;  opc.quantity,&#xD;&#xA;  opc.stackid,&#xD;&#xA;  opc.TrayFlag1,&#xD;&#xA;  opc.TrayFlag2,&#xD;&#xA;  opc.TrayFlag3,&#xD;&#xA;  opc.TrayFlag4,&#xD;&#xA;  opc.TrayFlag5,&#xD;&#xA;  opc.TrayFlag6,&#xD;&#xA;  opc.itemnumber,&#xD;&#xA;  rtrim(sid.linetype) linetype,&#xD;&#xA;  sid.IQMSWorkCenterID,&#xD;&#xA;  swo.DateTimeProdStart,&#xD;&#xA;  swo.WorkOrder,&#xD;&#xA;  swo.id,&#xD;&#xA;  swo.proditemnowamas,&#xD;&#xA;  swo.tipperItemNoWamas1,&#xD;&#xA;  swo.tipperQtyReq1,&#xD;&#xA;  swo.tipperQtyDel1,&#xD;&#xA;  swo.tipperItemNoWamas2,&#xD;&#xA;  swo.tipperQtyReq2,&#xD;&#xA;  swo.tipperQtyDel2,&#xD;&#xA;  swo.proditemcuredays,&#xD;&#xA;  swo.proditemshelflife,&#xD;&#xA;  swo.proditemnoiqms,&#xD;&#xA;  wlu.batch lubatch,&#xD;&#xA;  wlu.datecuring ludatecuring,&#xD;&#xA;  wlu.dateexpiry ludateexpiry,&#xD;&#xA;  wlu.itemnumber luitem,&#xD;&#xA;  opc.obdno addByUser,&#xD;&#xA;  /*isw.logical1 inboundDisable,&#xD;&#xA;  isw.logical2 outboundDisable,&#xA;  - modified to use autefa station id to enable/disable opc auto processing */&#xD;&#xA;  case&#xD;&#xA;      when sid.enableAutoAutefa = 1 then 0&#xD;&#xA;      else 1&#xD;&#xA;   end as  inboundDisablee,&#xD;&#xA;  case&#xD;&#xA;      when sid.enableAutoAutefa = 1 then 0&#xD;&#xA;      else 1&#xD;&#xA;   end as outboundDisable,&#xD;&#xA;isw.QAHold&#xD;&#xA;from IMS_OPC_transaction opc&#xD;&#xA;join IMS_Station_ID sid on sid.LineID = opc.LineID&#xD;&#xA;left outer join (select sid2.IQMSWorkCenterID, isw2.LineID, isw2.logical1,&#xA;  isw2.logical2, isw2.QAHold from IMS_Station_Weight isw2&#xD;&#xA;join IMS_Station_ID sid2 on isw2.LineID = sid2.LineID) isw on isw.IQMSWorkCenterID = &#xA; sid.IQMSWorkCenterId&#xD;&#xA;left outer join (select IQMSWorkCenterID, max(id) maxid&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;from IMS_Station_WO swosub group by IQMSWorkCenterID) lastWo on lastWo.IQMSWorkCenterID = &#xA; sid.IQMSWorkCenterID&#xD;&#xA;left outer join IMS_Station_WO swo on swo.id = lastwo.maxid&#xD;&#xA;left outer join IMS_WAMAS_LU wlu on wlu.stackid = opc.stackid&#xD;&#xA;where&#xD;&#xA;   opc.DateTimeProcessed is null&#xD;&#xA;order by&#xD;&#xA;   opc.id&quot;"/>
