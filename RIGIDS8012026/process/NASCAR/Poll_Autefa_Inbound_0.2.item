    <elementParameter field="TECHNICAL" name="PROPERTY:PROPERTY_TYPE" value="REPOSITORY" show="false"/>
    <elementParameter field="TECHNICAL" name="PROPERTY:REPOSITORY_PROPERTY_TYPE" value="_JovuEMrcEeegkf46nwJaMQ" show="false"/>
    <elementParameter field="TEXT" name="HOST" value="&quot;DALTALEND04&quot;" show="false"/>
    <elementParameter field="CLOSED_LIST" name="DRIVER" value="MSSQL_PROP" show="false"/>
    <elementParameter field="TEXT" name="TYPE" value="MSSQL" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="&quot;1433&quot;" show="false"/>
    <elementParameter field="TEXT" name="DB_SCHEMA" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;Talend-Rigids&quot;" show="false"/>
    <elementParameter field="TEXT" name="USER" value="&quot;sa&quot;" show="false"/>
    <elementParameter field="PASSWORD" name="PASS" value="enc:system.encryption.key.v1:OGllNZg6IT6jyaPKNgIepg/D8AUk20HUvmNeKwzOZ4VMObpD" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
