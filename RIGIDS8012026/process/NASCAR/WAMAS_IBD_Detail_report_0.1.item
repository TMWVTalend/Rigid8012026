  <node componentName="tJavaRow" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="832" posY="416">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJavaRow_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="//Code generated according to input schema and output schema&#xD;&#xA;output_row.LineID = input_row.LineID;&#xD;&#xA;output_row.WAMASTransactionType = input_row.WAMASTransactionType;&#xD;&#xA;output_row.CurrentStatus = input_row.CurrentStatus;&#xD;&#xA;output_row.DateTimeReceived = input_row.DateTimeReceived;&#xD;&#xA;output_row.DateTimeUpdated = input_row.DateTimeUpdated;&#xD;&#xA;JSONObject obj = new JSONObject(input_row.JSONData);&#xA;String valueINeed=&quot;&quot;;&#xA;int count = 0;&#xA;for (Object key : obj.keySet()) {&#xA;            //based on you key types&#xA;            String keyStr = (String)key;&#xA;            Object keyvalue = obj.get(keyStr);&#xA;&#xA;            valueINeed = keyStr;&#xA;            count++;&#xA;&#xA;            /*check here for the appropriate value and do whatever you want*/&#xA;            //Print key and value&#xA;            //System.out.println(&quot;key: &quot;+ keyStr + &quot; value: &quot; + keyvalue);&#xA;&#xA;            if(count==1)&#xA;                break;&#xA;&#xA;        }&#xA;&#xA;//System.out.println(valueINeed);&#xA;&#xA;output_row.ItemNo = &quot;&quot;;&#xA;output_row.StackId = &quot;&quot;;&#xA;&#xA;String JProdDate = &quot;&quot;;&#xA;Date JDate = null;&#xA;// pull item from IBDRequest JSON - Stack complete&#xA;if (valueINeed.equals(&quot;StackComplete&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;StackComplete&quot;);&#xA;output_row.ItemNo = Stack.get(&quot;ItemNumber&quot;).toString();&#xA;output_row.StackId = Stack.get(&quot;StackId&quot;).toString();&#xA;output_row.Batch = Stack.get(&quot;Workorder&quot;).toString();&#xA;SimpleDateFormat formatter = new SimpleDateFormat(&quot;yyyy-MM-dd'T'HH:mm:ss.SSSXXX&quot;);&#xA;JProdDate = Stack.get(&quot;DateProd&quot;).toString();&#xA;JDate = formatter.parse(JProdDate);&#xA;output_row.Quantity = Stack.get(&quot;Quantity&quot;).toString();&#xA;}&#xA;&#xA;// pull item from OBDRequest JSON&#xA;if (valueINeed.equals(&quot;OBDRequest&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;OBDRequest&quot;);&#xA;output_row.ItemNo = Stack.get(&quot;ItemNumber&quot;).toString();&#xA;}&#xA;&#xA;// pull stackid from transfer &#xA;if (valueINeed.equals(&quot;LUTransfer&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;LUTransfer&quot;);&#xA;output_row.StackId = Stack.get(&quot;StackId&quot;).toString();&#xA;}&#xA;&#xA;// pull ibd id from ibd cancel&#xA;if (valueINeed.equals(&quot;IBDCancel&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;IBDCancel&quot;);&#xA;output_row.StackId = Stack.get(&quot;TransID&quot;).toString();&#xA;}&#xA;&#xA;// pull obd id from obd cancel&#xA;if (valueINeed.equals(&quot;OBDCancel&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;OBDCancel&quot;);&#xA;output_row.StackId = Stack.get(&quot;TransID&quot;).toString();&#xA;}&#xA;&#xA;// pull obd id from obd cancel&#xA;if (valueINeed.equals(&quot;LUTransferCancel&quot;))&#xA;{&#xA;JSONObject Stack = obj.getJSONObject(&quot;LUTransferCancel&quot;);&#xA;output_row.StackId = Stack.get(&quot;TransID&quot;).toString();&#xA;}&#xA;// Calculate julian day character based on prod date&#xA;String bot_date = &quot;01/01/2000&quot;;&#xA;SimpleDateFormat sdf = new SimpleDateFormat(&quot;dd/MM/yyyy&quot;);&#xA;Date begin_of_time = sdf.parse(bot_date);&#xA;long diffInMilli = JDate.getTime() - begin_of_time.getTime();&#xA;long diff = TimeUnit.DAYS.convert(diffInMilli, TimeUnit.MILLISECONDS);&#xA;int diffint = (int)(diff % 26) + 65;&#xA;//System.out.println((char)diffint);&#xA;//System.out.println(&quot;Julian Day: &quot; + (char)diffint + &quot; Prod Date: &quot; + JProdDate);&#xA;output_row.JulianDay = (char)diffint;&#xA;output_row.ProdDate = JProdDate;&#xA;&#xA;&#xA;"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;&#xA;import org.json.JSONArray;&#xA;import org.json.JSONException;&#xA;import org.json.JSONObject;&#xA;import java.util.UUID;&#xA;import java.util.Date;&#xA;import java.text.SimpleDateFormat;&#xA;import java.util.concurrent.TimeUnit;"/>
    <elementParameter field="TEXT" name="LABEL" value="extract info from JSON"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
