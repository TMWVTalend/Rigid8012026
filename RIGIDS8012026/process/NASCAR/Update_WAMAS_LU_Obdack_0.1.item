    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select&#xD;&#xA;  isi.IQMSWorkCenterID,&#xD;&#xA;  isi.LineId,&#xD;&#xA;  isi.LineType,&#xD;&#xA;  isw.ProdItemNoWamas,&#xD;&#xA;  isw.TipperItemNoWamas1,&#xD;&#xA;  isw.TipperItemNoWamas2,&#xD;&#xA;  isw.TipperQtyDel1,&#xD;&#xA;  isw.TipperQtyDel2,&#xD;&#xA;  isw.id iswid,&#xD;&#xA;  isw.ProdItemNoIQMS,&#xD;&#xA;  isw.IQMSWorkCenterID,&#xD;&#xA;  isw.WorkOrder,&#xD;&#xA;  isw.TipperItemNoIQMS1&#xD;&#xA;from&#xD;&#xA; IMS_Station_ID isi&#xD;&#xA;inner join &#xD;&#xA;(select IQMSWorkCenterID, max(id) maxid&#xD;&#xA;  from IMS_Station_WO swosub&#xD;&#xA;  group by IQMSWorkCenterID) lastwo on lastwo.IQMSWorkCenterID = &#xD;&#xA; isi.IQMSWorkCenterID&#xD;&#xA;inner join IMS_Station_WO isw on isw.id = lastwo.maxid&#xD;&#xA;where&#xD;&#xA; isi.LineId =  '&quot; + globalMap.get(&quot;LineID&quot;) + &quot;'&quot;"/>
