  <node componentName="tOracleInput" componentVersion="0.102" offsetLabelX="0" offsetLabelY="0" posX="720" posY="720">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tOracleInput_3" show="false"/>
    <elementParameter field="CHECK" name="USE_EXISTING_CONNECTION" value="false"/>
    <elementParameter field="COMPONENT_LIST" name="CONNECTION" value="tOracleConnection_1" show="false"/>
    <elementParameter field="CLOSED_LIST" name="CONNECTION_TYPE" value="ORACLE_SERVICE_NAME"/>
    <elementParameter field="CLOSED_LIST" name="DB_VERSION" value="ORACLE_12"/>
    <elementParameter field="TEXT" name="RAC_URL" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="HOST" value="context.connection_iqms_IQMSJDBCHost"/>
    <elementParameter field="TEXT" name="TYPE" value="ORACLE_SERVICE_NAME" show="false"/>
    <elementParameter field="TEXT" name="PORT" value="context.connection_iqms_IQMSJDBCPort"/>
    <elementParameter field="TEXT" name="DBNAME" value="&quot;iqms&quot;"/>
    <elementParameter field="TEXT" name="LOCAL_SERVICE_NAME" value="&quot;&quot;" show="false"/>
    <elementParameter field="TEXT" name="SCHEMA_DB" value="&quot;IQMS&quot;"/>
    <elementParameter field="TEXT" name="USER" value="context.connection_iqms_IQMSJDBCUser"/>
    <elementParameter field="PASSWORD" name="PASS" value="context.connection_iqms_IQMSJDBCPass"/>
    <elementParameter field="TEXT" name="JDBC_URL" value="&quot;jdbc:oracle:oci:/@talend&quot;" show="false"/>
    <elementParameter field="DBTABLE" name="TABLE" value="&quot;&quot;"/>
    <elementParameter field="QUERYSTORE_TYPE" name="QUERYSTORE" value="&quot;&quot;"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:REPOSITORY_QUERYSTORE_TYPE" value="" show="false"/>
    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select&#xD;&#xA;&#x9;fgmulti.arinvt_id, arinvt.itemno,fgmulti.lotno&#xD;&#xA;  &#x9;from fgmulti, arinvt, locations&#xD;&#xA; &#x9;where fgmulti.eplant_id = &quot; + context.parameter_WebAPI_eplant_id + &quot;&#xD;&#xA;&#x9;and arinvt.id = fgmulti.arinvt_id&#xD;&#xA;&#x9;and arinvt.id = &quot; + globalMap.get(&quot;lotlist.item&quot;) + &quot;&#xD;&#xA;&#x9;and locations.id = fgmulti.loc_id&#xD;&#xA;    and locations.descrip = 'WAMAS Stack ID'&#xD;&#xA;    and (&#xD;&#xA;    (fgmulti.non_conform_id IS NOT NULL and 'hold' = '&quot; + globalMap.get(&quot;lotlist.holdFlag&quot;) + &quot;')&#xD;&#xA;    or &#xD;&#xA;    (fgmulti.non_conform_id is NULL and 'rel' = '&quot; + globalMap.get(&quot;lotlist.holdFlag&quot;) + &quot;')&#xD;&#xA;&#x9;or&#xD;&#xA;&#x9;( 'all' = '&quot; + globalMap.get(&quot;lotlist.holdFlag&quot;) + &quot;')&#xD;&#xA;    )&#xD;&#xA;    and fgmulti.onhand > 0&#xD;&#xA;    group by arinvt.itemno, fgmulti.arinvt_id,fgmulti.lotno&#xD;&#xA;    order by arinvt.itemno, fgmulti.lotno&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
