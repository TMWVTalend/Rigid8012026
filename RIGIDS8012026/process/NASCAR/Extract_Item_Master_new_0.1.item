    <elementParameter field="GUESS_SCHEMA" name="GUESS_SCHEMA" value="&quot;&quot;"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;select a.*, b.uom, b.conv_value, c.cust_itemno, d.cuser3 brand_code, e.wamas_assortment &#xD;&#xA;from arinvt a&#xD;&#xA;join arinvt_uom_conv b on b.arinvt_id = a.id&#xD;&#xA;join aka c on c.arinvt_id = a.id&#xD;&#xA;left outer join arinvt_group d on d.id = a.arinvt_group_id&#xD;&#xA;left outer join v_ud_arinvt_fg e on e.parent_id = a.id&#xD;&#xA;where a.eplant_id = '&quot; + context.parameter_WebAPI_eplant_id + &quot;' &#xD;&#xA;and a.itemno &lt; '5.' &#xD;&#xA;and not (a.itemno like '%EXP%'  or a.itemno like '%IMP%')&#xD;&#xA;and (pk_hide = 'N' or pk_hide IS NULL)&#xD;&#xA;and e.MASTER_DATA_WAMAS = 'Y'&#xD;&#xA;order by a.id, b.uom&#xD;&#xA;&quot;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime"/>
